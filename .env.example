# =====================================================
# 한국투자증권 KIS API 환경 설정
# 이 파일을 복사하여 .env 로 저장 후 실제 값으로 채워주세요.
# cp .env.example .env
# =====================================================

# --- 활성 투자 모드 ---
# true  = 모의투자 (테스트·파이프라인 기본)
# false = 실전투자 (KIS_LIVE_* 필수)
KIS_IS_MOCK=true

# --- 모의투자 프로필 (KIS Developers 모의 앱) ---
KIS_MOCK_APP_KEY=발급받은_모의_APP_KEY
KIS_MOCK_APP_SECRET=발급받은_모의_APP_SECRET
KIS_MOCK_ACCOUNT_NO=12345678-01

# --- 실전투자 프로필 (실전 전환 시 채우기) ---
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=

# --- 레거시 (KIS_MOCK_* 가 비어 있을 때만 폴백) ---
# KIS_APP_KEY=발급받은_APP_KEY
# KIS_APP_SECRET=발급받은_APP_SECRET
# KIS_ACCOUNT_NO=12345678-01

# --- 감시 종목 (쉼표로 구분, 종목코드 6자리) ---
# 삼성전자, SK하이닉스, NAVER
WATCHLIST=005930,000660,035420,035720,051910

# --- 전략 파라미터 ---
# 래리 윌리엄스 K 계수 (0.4 ~ 0.6 권장)
K_FACTOR=0.5

# 이동평균 기간 (일)
MA_PERIOD=5

# --- 리스크 관리 ---
# 손절선 비율 (0.02 = -2%)
STOP_LOSS_RATIO=0.02

# 종목당 최대 자산 비중 (0.10 = 10%)
MAX_POSITION_RATIO=0.10

# 당일 목표 수익률 달성 시 매매 종료 (0.03 = +3%)
DAILY_PROFIT_TARGET=0.03

# --- 스케줄러 설정 ---
# 전략 체크 주기 (초)
CHECK_INTERVAL_SECONDS=60

# --- Google Gemini (AI 후보·시장 리서치) ---
# https://aistudio.google.com/apikey — 무료 티어는 일·분당 한도가 작습니다(429 시 할당량 확인).
GEMINI_API_KEY=
# 선택: 기본 gemini-2.0-flash. 429이 잦으면 AI Studio에서 결제 연동 후 동일 키로 한도 상향 가능.
# GEMINI_MODEL_AI=gemini-2.0-flash
# GEMINI_MODEL_RESEARCH=gemini-2.0-flash
# 일일 성공 호출 상한(0=무제한). 무료 티어 절약: 예) 12~20. 초과 시 Firestore 캐시·알고리즘 폴백.
# 카운터는 UTC 날짜 기준 gemini_quota/{YYYY-MM-DD}.calls
# GEMINI_DAILY_CALL_BUDGET=16

# --- Claude / Cursor AI 종목 Push (claude_picker.py · pipeline/push.py) ---
# Firebase Functions 베이스 URL (예: https://us-central1-myproject.cloudfunctions.net/api)
AUTOSTOCK_API_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/api
# /api/ai/picks 인증 시크릿 — functions/.env 의 AI_PICKS_SECRET 와 동일값으로 설정
AUTOSTOCK_API_SECRET=your_secret_key_here
# 추천 종목 수 (기본 10)
# AUTOSTOCK_MAX_PICKS=10

# --- Cursor 감시목록 파이프라인 (python -m pipeline) ---
# 완전 자동 (Cursor 채팅 불필요):
#   python -m pipeline run --step daily
# macOS 평일 08:50 KST 스케줄:
#   ./scripts/install_launchd.sh
# PIPELINE_MIN_SCORE=0.62
# PIPELINE_MAX_WATCHLIST=10
# PIPELINE_EXPERT_MIN_SCORE=10
# PIPELINE_EXPERT_PUSH_GRADES=STRONG BUY

# --- 텔레그램 알림 (매매·시간 요약) ---
# autoShorts 등 다른 봇과 **동일** 토큰·chat_id 쓰면 그대로 맞출 수 있음.
# BotFather 토큰
TELEGRAM_BOT_TOKEN=123456:ABC-xxx...
# 메시지 받을 chat_id (사용자/그룹. 그룹은 -100... 형태)
TELEGRAM_CHAT_ID=45243705
# 아래는 동일 값의 별칭 (스크립트·타 프로젝트 호환)
# BOT_TOKEN=123456:ABC-xxx...
# CHAT_ID=45243705
# 포럼(토픽) 그룹일 때만: 스레드 ID
# TELEGRAM_MESSAGE_THREAD_ID=1
