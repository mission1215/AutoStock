# AutoStock Firebase Functions 환경변수
# 이 파일을 복사하여 functions/.env 로 저장 후 실제 값으로 채워주세요.
# cp functions/.env.example functions/.env
#
# 배포 시 firebase deploy 가 로컬 functions/.env 를 읽어 Cloud Run 환경변수로 주입합니다.
# git 에는 커밋하지 마세요.

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Claude / Cursor AI 피크 수신 시크릿 ---
# claude_picker.py · 루트 .env AUTOSTOCK_API_SECRET 과 동일값
# 생성법: openssl rand -hex 32
AI_PICKS_SECRET=

# --- 텔레그램 알림 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
