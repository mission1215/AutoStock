# 환경 변수 — private 레포이므로 둘 다 커밋 허용 (다중 PC 개발 환경)
!/.env
!functions/.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# 가상환경
venv/
env/
.venv/

# 로그
*.log
logs/

# IDE
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# 로컬 백업·임시 복사본 (커밋 제외)
*.bak

# Firebase 로컬 캐시
.firebase/

# Claude Code 로컬 설정
.claude/

# Watchlist pipeline artifacts
data/*.parquet
data/*.json
data/*.log
output/*.csv
output/*.md
!data/.gitkeep
!output/.gitkeep
